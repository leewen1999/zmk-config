// twelvepad - 12 keys, direct GPIO (no matrix, no diodes) + nice!view + low battery LED
// Each switch connects between its GPIO pin and GND (internal pull-up).

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

#include "twelvepad-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        // Key order = SW1 .. SW12 (top to bottom); must match twelvepad.keymap
        input-gpios
            = <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW1  P1.13  "1"
            , <&gpio1  0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW2  P1.00  "2"
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW3  P0.24  "3"
            , <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW4  P1.15  "4"
            , <&gpio0  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW5  P0.02  UP
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW6  P0.20  RIGHT
            , <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW7  P0.29  DOWN
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW8  P0.22  LEFT
            , <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW9  P0.17  ENTER
            , <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW10 P0.31  SPACE
            , <&gpio0  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW11 P0.06  Z
            , <&gpio0  8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW12 P0.08  X
            ;
    };

    default_transform: default_transform {
        // Direct GPIO is reported as a single row, one column per pin.
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <1>;

        map = <
            RC(0, 0) RC(0, 1) RC(0, 2)  RC(0, 3)  RC(0, 4)  RC(0, 5)
            RC(0, 6) RC(0, 7) RC(0, 8)  RC(0, 9)  RC(0, 10) RC(0, 11)
        >;
    };

    // Setup mode behavior (see src/setup_mode.c, used as &sm in the keymap)
    // + low battery LED (P0.15, the onboard LED, active high).
    sm: setup_mode {
        compatible = "zmk,behavior-setup-mode";
        #binding-cells = <1>;
        lowbat-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;  // LED_LOWBAT P0.15
    };

    // No "zmk,soft-off-wakeup-sources" node on purpose: after a soft off nothing
    // wakes the keyboard except the reset button (lowest power).
    // Deep sleep (CONFIG_ZMK_SLEEP) still wakes on any key through the
    // `wakeup-source` property of the kscan above.
};

// ---------------------------------------------------------------------------
// nice!view on its own SPI bus (the ZMK nice_view shield needs "nice_view_spi"):
//   CS   = P0.11   SCK = P1.11   MOSI = P0.10   (MISO not used)
//   VCC -> nice!nano VCC pin, GND -> GND
// P0.09 / P0.10 are NFC pins: CONFIG_NFCT_PINS_AS_GPIOS=y is required (see .conf).
// ---------------------------------------------------------------------------
&pinctrl {
    spi2_niceview_default: spi2_niceview_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };

    spi2_niceview_sleep: spi2_niceview_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 10)>;
            low-power-enable;
        };
    };
};

nice_view_spi: &spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi2_niceview_default>;
    pinctrl-1 = <&spi2_niceview_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
};
