// twelvepad - 12 keys, direct GPIO (no matrix, no diodes) + 4 indicator LEDs
// Each switch connects between its GPIO pin and GND (internal pull-up).

#include <dt-bindings/zmk/matrix_transform.h>

#include "twelvepad-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        // Key order = SW1 .. SW12 (top to bottom); must match twelvepad.keymap
        input-gpios
            = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW1  P0.17
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW2  P0.20
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW3  P0.22
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW4  P0.24
            , <&gpio1  0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW5  P1.00
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW6  P0.11
            , <&gpio1  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW7  P1.04
            , <&gpio1  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW8  P1.06
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW9  P1.11
            , <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW10 P1.13
            , <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW11 P1.15
            , <&gpio0  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW12 P0.02
            ;
    };

    default_transform: default_transform {
        // Direct GPIO is reported as a single row, one column per pin.
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <1>;

        map = <
            RC(0, 0) RC(0, 1) RC(0, 2)  RC(0, 3)  RC(0, 4)  RC(0, 5)
            RC(0, 6) RC(0, 7) RC(0, 8)  RC(0, 9)  RC(0, 10) RC(0, 11)
        >;
    };

    // 4 indicator LEDs (active high). Used through the &led_ind behavior
    // and for the BLE status blink (see src/led_indicator.c).
    led_ind: led_indicator {
        compatible = "zmk,behavior-led-indicator";
        #binding-cells = <1>;
        led-gpios
            = <&gpio0  8 GPIO_ACTIVE_HIGH>  // LED_0 P0.08
            , <&gpio0  6 GPIO_ACTIVE_HIGH>  // LED_1 P0.06
            , <&gpio0 29 GPIO_ACTIVE_HIGH>  // LED_2 P0.29
            , <&gpio0 31 GPIO_ACTIVE_HIGH>  // LED_3 P0.31
            ;
    };

    // Soft off: any key on the kscan above wakes the keyboard.
    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&kscan>;
    };
};
