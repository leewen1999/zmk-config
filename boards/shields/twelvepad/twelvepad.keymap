// twelvepad - 12 keys (SW1 top .. SW12 bottom), direct GPIO
//
//  pos  SW   key
//   0   SW1  1
//   1   SW2  2
//   2   SW3  3
//   3   SW4  4
//   4   SW5  UP
//   5   SW6  RIGHT
//   6   SW7  DOWN
//   7   SW8  LEFT
//   8   SW9  ENTER
//   9   SW10 SPACE
//  10   SW11 Z
//  11   SW12 X
//
// Combos (SW10 = position 9 is the "function" key):
//   SW10 + SW1..SW4   -> BT_SEL 0..3
//   SW10 + SW12 (hold)-> show current BT profile on LEDs
//   SW10 + SW11 (hold)-> show battery level on LEDs
//   SW9  + SW10 (hold 2s) -> LED animation, then soft off (any key wakes)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// &led_ind parameters
#define LED_SHOW_PROFILE 1
#define LED_SHOW_BATTERY 2
#define LED_SLEEP_ANIM   3

/ {
    behaviors {
        // Soft off, immediate (the 2 s hold is done by sleep_hold below)
        soft_off_now: soft_off_now {
            compatible = "zmk,behavior-soft-off";
            #binding-cells = <0>;
            hold-time-ms = <0>;
        };

        // Hold 2 s to run sleep_macro; releasing earlier does nothing
        sleep_hold: sleep_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <2000>;
            bindings = <&sleep_macro>, <&none>;
        };
    };

    macros {
        // Start the LED animation (takes 3 s), wait, then soft off
        sleep_macro: sleep_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings
                = <&macro_wait_time 3100>
                , <&macro_tap>
                , <&led_ind LED_SLEEP_ANIM>
                , <&soft_off_now>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bt_sel_0 {
            timeout-ms = <60>;
            key-positions = <9 0>;
            bindings = <&bt BT_SEL 0>;
        };
        combo_bt_sel_1 {
            timeout-ms = <60>;
            key-positions = <9 1>;
            bindings = <&bt BT_SEL 1>;
        };
        combo_bt_sel_2 {
            timeout-ms = <60>;
            key-positions = <9 2>;
            bindings = <&bt BT_SEL 2>;
        };
        combo_bt_sel_3 {
            timeout-ms = <60>;
            key-positions = <9 3>;
            bindings = <&bt BT_SEL 3>;
        };
        combo_show_profile {
            timeout-ms = <60>;
            key-positions = <9 11>;
            bindings = <&led_ind LED_SHOW_PROFILE>;
        };
        combo_show_battery {
            timeout-ms = <60>;
            key-positions = <9 10>;
            bindings = <&led_ind LED_SHOW_BATTERY>;
        };
        combo_sleep {
            timeout-ms = <60>;
            key-positions = <8 9>;
            bindings = <&sleep_hold 0 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp UP
                &kp RIGHT
                &kp DOWN
                &kp LEFT
                &kp ENTER
                &kp SPACE
                &kp Z
                &kp X
            >;
        };
    };
};
