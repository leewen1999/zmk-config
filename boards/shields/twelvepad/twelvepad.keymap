// twelvepad (nice!view version) - 12 keys (SW1 top .. SW12 bottom), direct GPIO, "setup mode"
// The nice!view shows the BT profile, battery and the active layer name
// (Default / Setup / Sleep), so no profile / battery LEDs are needed.
//
// Normal layer (0):
//   SW1..SW4 = 1 2 3 4, SW5..SW8 = UP RIGHT DOWN LEFT,
//   SW9 = ENTER (tap) / hold > 500 ms then release = enter setup mode,
//   SW10 = SPACE,
//   SW11 = Z, SW12 = X
//
// Setup layer (1) ("Setup" on the display):
//   SW1..SW4  click -> BT_SEL 0..3, leave setup mode
//   SW5..SW8  click -> BT_CLR for profile 0..3 (selects it, clears it), leave setup mode
//   SW9       click -> nothing, leave setup mode
//   SW10      click -> sleep ("Sleep" on the display for 1 s, then deep sleep or soft off,
//                       see .conf, once no key is held)
//   SW11/SW12 click -> nothing, leave setup mode
//
// Sleep layer (2): everything disabled while waiting for the sleep.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// &sm parameters (keep in sync with src/setup_mode.c)
#define SM_ENTER    1   // used by hold-tap: arms on hold, enters setup mode on release
#define SM_EXIT     2   // leave setup mode now
#define SM_CANCEL   3   // leave setup mode on release
#define SM_SLEEP    6   // on release: start sleep sequence

/ {
    behaviors {
        // SW9: tap = ENTER, hold > 500 ms = setup mode (entered on release)
        setup_ht: setup_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&sm>, <&kp>;
        };
    };

    macros {
        sm_sel0: sm_sel0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 0>, <&sm SM_EXIT>;
        };
        sm_sel1: sm_sel1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 1>, <&sm SM_EXIT>;
        };
        sm_sel2: sm_sel2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 2>, <&sm SM_EXIT>;
        };
        sm_sel3: sm_sel3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 3>, <&sm SM_EXIT>;
        };

        // BT_CLR only clears the *current* profile, so select it first.
        sm_clr0: sm_clr0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 0>, <&bt BT_CLR>, <&sm SM_EXIT>;
        };
        sm_clr1: sm_clr1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 1>, <&bt BT_CLR>, <&sm SM_EXIT>;
        };
        sm_clr2: sm_clr2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 2>, <&bt BT_CLR>, <&sm SM_EXIT>;
        };
        sm_clr3: sm_clr3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 3>, <&bt BT_CLR>, <&sm SM_EXIT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp UP
                &kp RIGHT
                &kp DOWN
                &kp LEFT
                &setup_ht SM_ENTER ENTER
                &kp SPACE
                &kp Z
                &kp X
            >;
        };

        setup_layer {
            display-name = "Setup";
            bindings = <
                &sm_sel0
                &sm_sel1
                &sm_sel2
                &sm_sel3
                &sm_clr0
                &sm_clr1
                &sm_clr2
                &sm_clr3
                &sm SM_CANCEL
                &sm SM_SLEEP
                &sm SM_CANCEL
                &sm SM_CANCEL
            >;
        };

        sleep_layer {
            display-name = "Sleep";
            bindings = <
                &none &none &none &none
                &none &none &none &none
                &none &none &none &none
            >;
        };
    };
};
