// swanboard - 12 keys (SW1 top .. SW12 bottom), direct GPIO, "setup mode".
// The same keymap is used by every hardware variant (LEDs / nice!view). What the
// setup-mode keys show depends on the variant (see src/setup_mode.c):
//   LEDs      : the 4 profile LEDs show everything
//   nice!view : the display shows the profile, battery and the layer name
//
// Normal layer (0, "GAME"):
//   SW1..SW4 = 1 2 3 4, SW5..SW8 = UP RIGHT DOWN LEFT,
//   SW9 = ENTER (down on press, up on release, like any key); released after
//         more than 1000 ms = also enter setup mode,
//   SW10 = SPACE,
//   SW11 = Z, SW12 = X
//
// Setup layer (1, "SETTING"):
//   SW1..SW4  click -> BT_SEL 0..3, leave setup mode (LEDs: LED of that profile 500 ms)
//   SW5..SW8  click -> BT_CLR for profile 0..3 (selects it, clears it), leave setup mode
//   SW9       click -> nothing, leave setup mode
//   SW10      click -> sleep (animation / "POWER" on the display, then deep sleep or soft off,
//                       see .conf, once no key is held)
//   SW11      LEDs: hold = battery level on the LEDs, release = leave setup mode
//             nice!view: click = leave setup mode
//   SW12      LEDs: hold = current BT profile on the LED, release = leave setup mode
//             nice!view: click = leave setup mode
//
// Sleep layer (2, "POWER"): everything disabled while waiting for the sleep.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// &sm parameters (keep in sync with src/setup_mode.c)
#define SM_ENTER_DOWN 7   // SW9 pressed: remember the time
#define SM_ENTER_UP   8   // SW9 released: held > 1000 ms -> enter setup mode
#define SM_EXIT       2   // leave setup mode now
#define SM_CANCEL     3   // leave setup mode on release
#define SM_BATTERY    4   // LEDs: hold = battery level; otherwise: leave setup mode on release
#define SM_PROFILE    5   // LEDs: hold = BT profile;    otherwise: leave setup mode on release
#define SM_SLEEP      6   // on release: start sleep sequence
#define SM_SELECTED_0 10  // after BT_SEL 0: leave setup mode (LEDs: LED_0 on for 500 ms)
#define SM_SELECTED_1 11  // ... profile 1
#define SM_SELECTED_2 12  // ... profile 2
#define SM_SELECTED_3 13  // ... profile 3

/ {
    macros {
        // SW9 = ENTER that behaves like a normal key: key down when the switch is pressed,
        // key up when it is released. In addition &sm remembers the press time; when the
        // switch is released after more than 1000 ms, setup mode is entered (src/setup_mode.c).
        // (&macro_pause_for_release keeps the macro waiting for the physical release.)
        enter_key: enter_key {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &kp ENTER &sm SM_ENTER_DOWN>,
                       <&macro_pause_for_release>,
                       <&macro_release &kp ENTER &sm SM_ENTER_UP>;
        };

        sm_sel0: sm_sel0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 0>, <&sm SM_SELECTED_0>;
        };
        sm_sel1: sm_sel1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 1>, <&sm SM_SELECTED_1>;
        };
        sm_sel2: sm_sel2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 2>, <&sm SM_SELECTED_2>;
        };
        sm_sel3: sm_sel3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 3>, <&sm SM_SELECTED_3>;
        };

        // BT_CLR only clears the *current* profile, so select it first.
        sm_clr0: sm_clr0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 0>, <&bt BT_CLR>, <&sm SM_EXIT>;
        };
        sm_clr1: sm_clr1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 1>, <&bt BT_CLR>, <&sm SM_EXIT>;
        };
        sm_clr2: sm_clr2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 2>, <&bt BT_CLR>, <&sm SM_EXIT>;
        };
        sm_clr3: sm_clr3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&bt BT_SEL 3>, <&bt BT_CLR>, <&sm SM_EXIT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "GAME";
            bindings = <
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp UP
                &kp RIGHT
                &kp DOWN
                &kp LEFT
                &enter_key
                &kp SPACE
                &kp Z
                &kp X
            >;
        };

        setup_layer {
            display-name = "SETTING";
            bindings = <
                &sm_sel0
                &sm_sel1
                &sm_sel2
                &sm_sel3
                &sm_clr0
                &sm_clr1
                &sm_clr2
                &sm_clr3
                &sm SM_CANCEL
                &sm SM_SLEEP
                &sm SM_BATTERY
                &sm SM_PROFILE
            >;
        };

        sleep_layer {
            display-name = "POWER";
            bindings = <
                &none &none &none &none
                &none &none &none &none
                &none &none &none &none
            >;
        };
    };
};
